# Firebase client
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Firebase Admin (server only)
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# AI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
GEMINI_GOOGLE_SEARCH=false

# ImageKit (server only)
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id/

# PesaPal
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_URL=https://your-domain.example.com/api/payments/pesapal/ipn
PESAPAL_IPN_ID=your-pesapal-ipn-id

# Credits
MONTHLY_FREE_CREDITS=10
CREDIT_COST_BASIC_CHAT=1
CREDIT_COST_STUDY_EXPLAIN=1
CREDIT_COST_STUDY_PRACTICE=2
CREDIT_COST_STUDY_QUIZ=3
CREDIT_COST_STUDY_SUMMARY=2
CREDIT_COST_STUDY_PLAN=2
CREDIT_COST_STUDY_CHECK=1
CREDIT_COST_RESEARCH=3
CREDIT_COST_CREATE=2
CREDIT_COST_TEACHER_TOOLS=2
CREDIT_COST_MULTIMODAL_CHAT=2
