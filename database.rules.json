{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "stock": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && newData.child('role').val() === 'customer' && newData.child('active').val() === true))",
        "uid": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && newData.val() === $uid))"
        },
        "name": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)"
        },
        "email": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)",
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === auth.token.email"
        },
        "phone": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)"
        },
        "address": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)"
        },
        "photoURL": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)"
        },
        "role": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && newData.val() === 'customer'))"
        },
        "active": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "createdAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "updatedAt": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)"
        },
        "$other": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": false
        },
        ".validate": "(data.exists() && ((newData.child('role').val() === data.child('role').val() && newData.child('uid').val() === data.child('uid').val() && newData.child('active').val() === data.child('active').val()) || root.child('users').child(auth.uid).child('role').val() === 'admin')) || (!data.exists() && auth.uid === $uid && newData.hasChildren(['uid', 'name', 'email', 'role', 'active', 'createdAt']) && newData.child('uid').val() === auth.uid && newData.child('role').val() === 'customer' && newData.child('active').val() === true)"
      }
    },
    "carts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$productId": {
          ".validate": "newData.hasChildren(['quantity']) && newData.child('quantity').isNumber() && newData.child('quantity').val() >= 1 && newData.child('quantity').val() <= 99"
        }
      }
    },
    "wishlists": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$orderId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists()))",
          ".validate": "data.exists() || (newData.child('userId').val() === $uid && newData.child('orderId').val() === $orderId && newData.child('status').val() === 'pending' && newData.child('paymentStatus').val() === 'pending' && newData.child('stockDeducted').val() === false && newData.child('stockRestored').val() === false)",
          "orderId": {},
          "userId": {},
          "customerName": {},
          "customerPhone": {},
          "items": {},
          "subtotal": {},
          "total": {},
          "status": {},
          "paymentStatus": {},
          "stockDeducted": {},
          "stockRestored": {},
          "paymentPhone": {},
          "paymentReference": {},
          "shippingAddress": {},
          "createdAt": {},
          "updatedAt": {},
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "specialOrders": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      ".indexOn": ["userId"],
      "$orderId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === newData.child('userId').val() && !data.exists() && newData.child('status').val() === 'pending'))",
        ".validate": "data.exists() || (newData.child('orderId').val() === $orderId && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'pending' && newData.hasChildren(['orderId', 'userId', 'customerName', 'phone', 'request', 'status', 'createdAt']))",
        "orderId": {},
        "userId": {},
        "customerName": {},
        "phone": {},
        "request": {},
        "description": {},
        "status": {},
        "createdAt": {},
        "price": {},
        "total": {},
        "paymentStatus": {},
        "updatedAt": {},
        "$other": {
          ".validate": false
        }
      }
    }
  }
}